        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅用于在本地内存中实时扫描 TOTP 双重验证二维码，图像绝不上传或落盘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅用於在本地記憶體中即時掃描 TOTP 雙重驗證 QR 碼，影像絕不上傳或寫入磁碟。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperren Sie Ihren lokalen Keysmith-Tresor und bestätigen Sie den Zugriff auf Passkeys und sensible Einträge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock your local Keysmith vault and verify sensitive passkey or item access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloquea tu bóveda local de Keysmith y verifica el acceso a passkeys y elementos confidenciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déverrouillez votre coffre Keysmith local et vérifiez l'accès aux clés d'accès et éléments sensibles."
          }
        },
