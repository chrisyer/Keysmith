    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannen Sie TOTP-2FA-QR-Codes lokal im Arbeitsspeicher. Bilder werden niemals hochgeladen oder auf das Gerät gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan TOTP 2FA QR codes locally in memory. Images are never uploaded or written to disk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea códigos QR TOTP 2FA localmente en memoria. Las imágenes nunca se suben ni se guardan en disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez les QR codes 2FA TOTP localement en mémoire. Les images ne sont jamais envoyées ni écrites sur le disque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOTP 2FA QRコードをメモリ上でローカルスキャンします。画像はアップロードや保存を一切行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TOTP 2FA QR 코드를 메모리에서 로컬로 스캔합니다. 이미지는 업로드되거나 디스크에 저장되지 않습니다."
