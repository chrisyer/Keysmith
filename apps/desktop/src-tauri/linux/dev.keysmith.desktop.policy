<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Keysmith</vendor>
  <vendor_url>https://github.com/chrisyer/Keysmith</vendor_url>
  <action id="dev.keysmith.desktop.unlock">
    <description>Unlock Keysmith Vault</description>
    <message>Authenticate to unlock Keysmith vault or approve sensitive operations</message>
    <icon_name>keysmith</icon_name>
    <defaults>
      <allow_any>auth_self</allow_any>
      <allow_inactive>auth_self</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
