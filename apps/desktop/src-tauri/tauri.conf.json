{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keysmith",
  "version": "0.1.4",
  "identifier": "dev.keysmith.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keysmith",
        "width": 1240,
        "height": 800,
        "minWidth": 920,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost https://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost ws: wss:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../browser-extension/*": "browser-extension/",
      "../../browser-extension/icons/*": "browser-extension/icons/",
      "../../browser-extension/_locales/en/*": "browser-extension/_locales/en/",
      "../../browser-extension/_locales/zh_CN/*": "browser-extension/_locales/zh_CN/",
      "../../browser-extension/_locales/zh_TW/*": "browser-extension/_locales/zh_TW/",
      "../../browser-extension/_locales/ja/*": "browser-extension/_locales/ja/",
      "../../browser-extension/_locales/ko/*": "browser-extension/_locales/ko/",
      "../../browser-extension/_locales/de/*": "browser-extension/_locales/de/",
      "../../browser-extension/_locales/fr/*": "browser-extension/_locales/fr/",
      "../../browser-extension/_locales/es/*": "browser-extension/_locales/es/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/share/polkit-1/actions/dev.keysmith.desktop.policy": "linux/dev.keysmith.desktop.policy"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/polkit-1/actions/dev.keysmith.desktop.policy": "linux/dev.keysmith.desktop.policy"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
